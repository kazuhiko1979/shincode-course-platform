{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/validate-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__supabase__(apply_migration|execute_sql)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/validate-supabase-write.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/lint-on-save.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
